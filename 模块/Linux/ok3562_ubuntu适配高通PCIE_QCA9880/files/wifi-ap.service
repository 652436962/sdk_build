[Unit]
Description=WiFi AP on wlp1s0 (hostapd + dnsmasq)
After=network.target systemd-modules-load.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/wifi-ap.sh
ExecStop=/bin/sh -c "killall hostapd dnsmasq 2>/dev/null; ip link set wlp1s0 down 2>/dev/null"

[Install]
WantedBy=multi-user.target
