[Unit]
Description=4G Network Sharing Service
After=network.target

[Service]
Type=simple
ExecStartPre=/sbin/udhcpc -i usb0
ExecStartPre=/bin/sleep 3
ExecStartPre=/sbin/ifconfig eth0 192.168.1.1 netmask 255.255.255.0 up
ExecStart=/bin/sh -c '\
echo 1 > /proc/sys/net/ipv4/ip_forward; \
iptables -t nat -C POSTROUTING -o usb0 -j MASQUERADE 2>/dev/null || \
  iptables -t nat -A POSTROUTING -o usb0 -j MASQUERADE; \
iptables -C FORWARD -i eth0 -o usb0 -j ACCEPT 2>/dev/null || \
  iptables -A FORWARD -i eth0 -o usb0 -j ACCEPT; \
iptables -C FORWARD -i usb0 -o eth0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
  iptables -A FORWARD -i usb0 -o eth0 -m state --state RELATED,ESTABLISHED -j ACCEPT'
ExecStop=/bin/sh -c '\
iptables -t nat -D POSTROUTING -o usb0 -j MASQUERADE 2>/dev/null; \
iptables -D FORWARD -i eth0 -o usb0 -j ACCEPT 2>/dev/null; \
iptables -D FORWARD -i usb0 -o eth0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null'
RemainAfterExit=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
